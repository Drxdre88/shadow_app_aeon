# Database
DATABASE_URL=postgresql://user:password@host/dbname

# NextAuth
AUTH_SECRET=your-random-secret-here

# OAuth Providers (at least one required for login)
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# Magic link email provider (optional, requires Resend account)
AUTH_RESEND_KEY=re_your_resend_api_key
EMAIL_FROM=Aeon <noreply@yourdomain.com>

# Admin accounts (comma-separated emails granted admin role on first sign-in)
ADMIN_EMAILS=admin@example.com

# MCP / API access
AEON_API_KEY=your-api-key-for-mcp-access
AEON_API_USER_ID=the-user-uuid-for-api-requests
