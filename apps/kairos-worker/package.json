{
  "name": "@aeon/kairos-worker",
  "version": "0.0.1",
  "private": true,
  "description": "Kairos spawn worker — long-running Node service that shells Claude Code / Codex CLIs on behalf of the operator and streams events back to Aeon.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
