# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* into the app bundle.

# Where the Aeon REST API lives. Use your machine's LAN IP (not localhost) when
# testing on a physical phone, e.g. http://192.168.1.42:3000. Prod: https://aeon.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Google OAuth WEB client id. MUST be identical to the server's AUTH_GOOGLE_ID
# (the mobile login endpoint checks the ID token's `aud` against it).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google OAuth iOS client id (Google Cloud Console -> Credentials -> iOS).
# Its reversed form also goes into app.json plugins iosUrlScheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
